<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\tModLoader.targets" />
  <PropertyGroup>
    <RootNamespace>PetAnyone</RootNamespace>
    <!-- True packages the dependency mod. Set to false for a library only DLL build. -->
    <BuildMod>true</BuildMod>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12.0</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <!-- Defines the conditional lifecycle compile only when this project is built as a mod.
       This group must stay after the BuildMod assignment above. -->
  <PropertyGroup Condition="'$(BuildMod)' == 'true'">
    <DefineConstants>$(DefineConstants);PETANYONE_MOD_BUILD</DefineConstants>
  </PropertyGroup>
  <!--
  Example for consumers: add a target like this to your own .csproj to copy the built dll into your mod lib folder.
  <Target Name="CopyToConsumerLib" AfterTargets="Build" Condition="Exists('..\YourConsumerMod\lib')">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="..\YourConsumerMod\lib" />
  </Target>
  -->
</Project>
