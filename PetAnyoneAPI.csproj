<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\tModLoader.targets" />
  <PropertyGroup>
    <RootNamespace>PetAnyone</RootNamespace>
    <!-- True packages the dependency mod. Set to false for a library only DLL build. -->
    <BuildMod>true</BuildMod>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <!-- Defines the library only compile when this project is not built as a mod. The lifecycle
       classes compile unless this is a library only build, because the in-game tModLoader
       compiler cannot see csproj properties. This group must stay after the BuildMod
       assignment above. -->
  <PropertyGroup Condition="'$(BuildMod)' != 'true'">
    <DefineConstants>$(DefineConstants);PETANYONE_DLL_BUILD</DefineConstants>
  </PropertyGroup>
  <!--
  Example for consumers: add a target like this to your own .csproj to copy the built dll into your mod lib folder.
  <Target Name="CopyToConsumerLib" AfterTargets="Build" Condition="Exists('..\YourConsumerMod\lib')">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="..\YourConsumerMod\lib" />
  </Target>
  -->
</Project>
